{
  "$defs": {
    "Image": {
      "additionalProperties": false,
      "description": "An image block. ``sha256`` hashes the decoded C-order uint8 pixel array plus its shape,\nnot the encoded bytes, so re-encoding never changes it. ``bytes_`` is transport only and is\nexcluded from request keys and cassettes.",
      "properties": {
        "bytes_": {
          "anyOf": [
            {
              "format": "base64url",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "format": {
          "enum": [
            "png",
            "jpeg"
          ],
          "title": "Format",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "type": {
          "const": "image",
          "default": "image",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "format",
        "sha256"
      ],
      "title": "Image",
      "type": "object"
    },
    "Json": {
      "additionalProperties": false,
      "properties": {
        "json_": {
          "additionalProperties": true,
          "title": "Json",
          "type": "object"
        },
        "type": {
          "const": "json",
          "default": "json",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "json_"
      ],
      "title": "Json",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "discriminator": {
              "mapping": {
                "image": "#/$defs/Image",
                "reasoning": "#/$defs/Reasoning",
                "text": "#/$defs/Text",
                "tool_result": "#/$defs/ToolResult",
                "tool_use": "#/$defs/ToolUse"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Text"
              },
              {
                "$ref": "#/$defs/Image"
              },
              {
                "$ref": "#/$defs/ToolUse"
              },
              {
                "$ref": "#/$defs/ToolResult"
              },
              {
                "$ref": "#/$defs/Reasoning"
              }
            ]
          },
          "title": "Content",
          "type": "array"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    },
    "ProviderEvent": {
      "additionalProperties": false,
      "description": "A span event raised inside a provider call (e.g. ``treehouse.retry``); the harness copies it onto the\nchat span.",
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "default": {},
          "title": "Attributes",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProviderEvent",
      "type": "object"
    },
    "Reasoning": {
      "additionalProperties": false,
      "properties": {
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "reasoning",
          "default": "reasoning",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Reasoning",
      "type": "object"
    },
    "Text": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Text",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "discriminator": {
              "mapping": {
                "image": "#/$defs/Image",
                "json": "#/$defs/Json",
                "text": "#/$defs/Text"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Text"
              },
              {
                "$ref": "#/$defs/Image"
              },
              {
                "$ref": "#/$defs/Json"
              }
            ]
          },
          "title": "Content",
          "type": "array"
        },
        "status": {
          "enum": [
            "success",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_use_id": {
          "title": "Tool Use Id",
          "type": "string"
        },
        "type": {
          "const": "tool_result",
          "default": "tool_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "tool_use_id",
        "status",
        "content"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "ToolUse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "tool_use",
          "default": "tool_use",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "input"
      ],
      "title": "ToolUse",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cache_read": {
          "default": 0,
          "title": "Cache Read",
          "type": "integer"
        },
        "cache_write": {
          "default": 0,
          "title": "Cache Write",
          "type": "integer"
        },
        "image_input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Input Tokens"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProviderEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "latency_ms": {
      "title": "Latency Ms",
      "type": "integer"
    },
    "message": {
      "$ref": "#/$defs/Message"
    },
    "price_table_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price Table Version"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "response_model_id": {
      "title": "Response Model Id",
      "type": "string"
    },
    "stop_reason": {
      "enum": [
        "end_turn",
        "tool_use",
        "max_tokens",
        "stop_sequence",
        "content_filtered",
        "guardrail",
        "guardrail_intervened",
        "malformed_model_output",
        "malformed_tool_use",
        "model_context_window_exceeded"
      ],
      "title": "Stop Reason",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "message",
    "stop_reason",
    "usage",
    "latency_ms",
    "response_model_id"
  ],
  "title": "ModelResponse",
  "type": "object"
}
