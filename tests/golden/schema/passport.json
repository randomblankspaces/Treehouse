    "Estimand": {
      "additionalProperties": false,
      "description": "``verified_precision`` is the trust headline: a lower bound on precision, since a claim\nnobody could verify never counts as correct.",
      "properties": {
        "kind": {
          "enum": [
            "precision",
            "verified_precision",
            "count",
            "miss_rate"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "population": {
          "enum": [
            "claim_table",
            "unreported_frame"
