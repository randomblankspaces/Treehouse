          "title": "Population",
          "type": "string"
        },
        "question_id": {
          "enum": [
            "exists",
            "damaged"
          ],
          "title": "Question Id",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "step_id",
        "question_id",
        "population"
      ],
      "title": "Estimand",
      "type": "object"
