          "default": true,
          "title": "Shuffle",
          "type": "boolean"
        }
      },
      "required": [
        "hide"
      ],
      "title": "BlindProtocol",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Per-run limits; ``None`` means no limit on that axis. ``enabled=False`` disables all limits.",
