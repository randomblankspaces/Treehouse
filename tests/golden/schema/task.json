          "type": "integer"
        },
        "max_out_px": {
          "minimum": 1,
          "title": "Max Out Px",
          "type": "integer"
        },
        "max_side_m": {
          "exclusiveMinimum": 0,
          "title": "Max Side M",
          "type": "number"
        }
      },
      "required": [
        "max_side_m",
        "max_out_px",
        "max_bytes_per_run"
      ],
      "title": "Windows",
      "type": "object"
