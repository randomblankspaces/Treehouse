  "additionalProperties": false,
  "description": "A task card.\n\n``synthetic`` means *synthetic task* (written by the team, not a partner's), which requires\n``synthetic_notice``. It does not decide the per-number ``synthetic`` flag: that comes from the data\na number was computed on (a source with ``access: synthetic``, a synthetic key or labeller, or a\n``WindowResult.synthetic``), so a real-data run of a synthetic task is not chipped SYNTHETIC.\n\nThe worker sees ``goal``, the AOI, the time window and the tools only. ``known_limits``,\n``must_notice``, keys and plans are grader-side and never enter a worker prompt. ``as_of`` is\nnormalised to UTC so the card hash does not depend on the offset it was written with.",
  "properties": {
    "aoi": {
      "$ref": "#/$defs/Polygon"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "classes": {
      "additionalProperties": {
        "$ref": "#/$defs/ClassSpec"
      },
      "title": "Classes",
      "type": "object"
    },
    "data_allowlist": {
      "items": {
        "$ref": "#/$defs/DataSource"
      },
      "title": "Data Allowlist",
      "type": "array"
    },
    "event": {
      "anyOf": [
        {
          "$ref": "#/$defs/Event"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "family": {
      "title": "Family",
      "type": "string"
    },
    "forbidden_sources": {
      "items": {
        "$ref": "#/$defs/ForbiddenSource"
      },
      "title": "Forbidden Sources",
      "type": "array"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "gold_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoldPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "known_limits": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Known Limits",
      "type": "array"
    },
    "minutes_per_cell": {
      "default": 2.0,
      "exclusiveMinimum": 0,
      "title": "Minutes Per Cell",
      "type": "number"
    },
    "must_notice": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NoticeItem"
      },
      "title": "Must Notice",
      "type": "array"
    },
    "needs_vision": {
      "title": "Needs Vision",
      "type": "boolean"
    },
    "sampling_plan": {
      "$ref": "#/$defs/SamplingPlan"
    },
    "schema_version": {
      "const": "treehouse.task/1",
      "default": "treehouse.task/1",
      "title": "Schema Version",
      "type": "string"
    },
    "smoke_aoi": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Smoke Aoi"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "synthetic_notice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Synthetic Notice"
    },
    "thresholds": {
      "$ref": "#/$defs/Thresholds"
    },
    "time_window": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "format": "date",
          "type": "string"
        }
      ],
      "title": "Time Window",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "tools_allowed": {
      "items": {
        "type": "string"
      },
      "title": "Tools Allowed",
      "type": "array"
    },
    "user_examples": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UserExample"
      },
      "title": "User Examples",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "windows": {
      "$ref": "#/$defs/Windows"
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "family",
    "synthetic",
    "goal",
    "aoi",
    "time_window",
    "as_of",
    "data_allowlist",
    "tools_allowed",
    "needs_vision",
    "classes",
    "windows",
    "steps",
    "forbidden_sources",
    "sampling_plan",
    "thresholds",
    "budget"
  ],
  "title": "TaskCard",
  "type": "object"
}
