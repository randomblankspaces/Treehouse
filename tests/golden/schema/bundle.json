    "CheckLedger": {
      "additionalProperties": false,
      "description": "Resolution order: rule fail > human > key > verifier > unchecked.",
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "resolved": {
          "enum": [
            "correct",
            "incorrect",
            "fabrication",
            "ungrounded",
            "contaminated",
            "to_adjudicate",
            "unchecked"
          ],
          "title": "Resolved",
          "type": "string"
        },
        "resolved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved By"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "results",
        "resolved"
      ],
      "title": "CheckLedger",
      "type": "object"
    },
    "CheckResult": {
