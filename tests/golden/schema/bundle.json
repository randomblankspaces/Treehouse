    "Estimand": {
      "additionalProperties": false,
      "description": "``verified_precision`` is the trust headline whenever any gold label is ``cannot_assess``: a lower\nbound on precision, since a claim nobody could verify never counts as correct. ``precision`` is used\nonly when ``n_gold_cannot_assess == 0`` (the passport validator enforces both directions).",
      "properties": {
        "kind": {
          "enum": [
            "precision",
            "verified_precision",
            "count",
            "miss_rate"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "population": {
          "enum": [
            "claim_table",
            "unreported_frame"
          ],
          "title": "Population",
          "type": "string"
        },
        "question_id": {
          "enum": [
            "exists",
            "damaged"
          ],
          "title": "Question Id",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "step_id",
        "question_id",
        "population"
      ],
      "title": "Estimand",
      "type": "object"
    },
