    "TrustPassport": {
      "additionalProperties": false,
      "description": "The trust panel for one estimand.\n\nContainer fence (\u00a72): ``headline``, ``alternatives`` and ``truth_reveal`` are trust-panel numbers and\nare never MEASURED; every ``controls`` number sits on the controls panel. ``narrowing_note`` is plain\ntext rendered inside the headline's chip element; any count it mentions repeats ``headline.n_gold``.\nGolden comparisons use ``canon.stable_view`` (``code_sha`` and ``manifest_ref`` are volatile).",
      "properties": {
        "alternatives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TypedNumber"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "beat_baseline": {
          "title": "Beat Baseline",
          "type": "string"
        },
        "code_sha": {
          "title": "Code Sha",
          "type": "string"
        },
        "controls": {
          "$ref": "#/$defs/ControlsReport"
        },
        "disagreement": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Disagreement",
