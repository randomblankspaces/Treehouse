            "$ref": "#/$defs/CheckResult"
          },
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "results",
        "resolved"
      ],
      "title": "CheckLedger",
      "type": "object"
    },
